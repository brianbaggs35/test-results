# Slack Incoming Webhook URL used by the Publish tab to post test result
# summaries directly to Slack. Create one at:
# https://api.slack.com/messaging/webhooks
#
# Copy this file to .env and fill in your real URL. Restart `npm run dev`
# after changing it.
SLACK_WEBHOOK_URL=SLACK_WEBHOOK_URL_GOES_HERE

# Optional: pre-fills the "Executed By" metadata row on the Publish page
# with this name, so you don't have to retype it on every publish. Must
# keep the VITE_ prefix — this one is read in the browser, not the server.
VITE_EXECUTED_BY=NAME
