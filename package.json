{
  "name": "test-results",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "npx vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lintfix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "preview": "npx vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test -c playwright.config.ts --retries=1",
    "test:e2e:coverage": "rm -rf .nyc_output && npx playwright test -c playwright.config.ts --retries=1 && npx nyc report --reporter=text --reporter=html",
    "test:ci": "npx playwright test -c playwright.config.ts --retries=1 --workers=1 && npx nyc report --reporter=text",
    "test:e2e:ui": "npx playwright test --ui",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "testbeats": "2.7.2"
  },
  "overrides": {
    "test-results-parser": "0.4.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.3",
    "autoprefixer": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^27.2.0",
    "nyc": "^17.1.0",
    "postcss": "latest",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^7.3.2",
    "vite-plugin-istanbul": "^9.0.0",
    "vitest": "^3.2.3"
  },
  "allowScripts": {
    "core-js@3.43.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
